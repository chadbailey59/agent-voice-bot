# Copy to .env and fill in. .env is gitignored.

# --- Voice profile -------------------------------------------------------
# Picks STT, LLM, and TTS together. Mixing across profiles is not supported.
#   hosted -> Deepgram STT, Nemotron on Baseten, Gradium TTS
#   local  -> Parakeet ASR, Nemotron, Magpie TTS, all on NIMs you host
VOICE_PROFILE=hosted

# --- hosted profile ------------------------------------------------------
DEEPGRAM_API_KEY=
BASETEN_API_KEY=
GRADIUM_API_KEY=

# Defaults to nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B on Baseten's shared
# Model APIs. Nano and Super are faster and better suited to a voice loop, but
# are served from dedicated deployments: set both of these from the Baseten
# dashboard, since the URL and the served model name move together.
# BASETEN_BASE_URL=https://model-{model_id}.api.baseten.co/environments/production/sync/v1
# BASETEN_MODEL=nvidia/NVIDIA-Nemotron-3-Nano
# GRADIUM_VOICE_ID=

# --- local profile (VOICE_PROFILE=local) ---------------------------------
# Needs `uv sync --extra nvidia`. No API key: a local NIM authenticates
# nothing. Deploying the speech NIMs is covered by the
# skills/nvidia-riva-speech skill.
#
# Each Riva NIM serves gRPC on 50051 inside its own container, so publish the
# TTS one on a different host port when both run on one machine.
# NVIDIA_ASR_SERVER=localhost:50051
# NVIDIA_TTS_SERVER=localhost:50052
#
# The voice-loop LLM: an OpenAI-compatible Nemotron NIM you run yourself, not
# NVIDIA's cloud endpoint.
# NVIDIA_LLM_BASE_URL=http://localhost:8000/v1
# NVIDIA_LLM_MODEL=nvidia/nvidia-nemotron-3-nano
#
# Labels for metrics and logs only. Riva binds the acoustic model when the NIM
# container starts (CONTAINER_ID, NIM_TAGS_SELECTOR) and the client sends an
# empty model name, so editing these does not switch models.
# NVIDIA_ASR_MODEL=parakeet-1.1b-en-US-asr-streaming
# NVIDIA_TTS_MODEL=magpie-tts-multilingual
#
# Defaults to Magpie-Multilingual.EN-US.Aria, which the default TTS model
# serves. A fastpitch-hifigan-en-us NIM serves different voices; set one here.
# NVIDIA_TTS_VOICE=
#
# For a remote or NVCF endpoint rather than a local NIM: enable TLS, supply a
# key, and set the TTS function id to the NVCF UUID.
# NVIDIA_API_KEY=
# NVIDIA_ASR_USE_SSL=false
# NVIDIA_TTS_USE_SSL=false
# NVIDIA_TTS_FUNCTION_ID=

# --- Agent loop: OpenClaw Gateway in a NemoClaw sandbox -------------------
# 18790 is the port a NemoClaw sandbox publishes, not OpenClaw's own 18789.
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18790
# OPENCLAW_SESSION_KEY=agent:main:main
# OPENCLAW_TIMEOUT_SECS=300
# OPENCLAW_TOKEN=
# OPENCLAW_PASSWORD=

# AGENT_VOICE_SKIP_DOTENV=1  # CI: use exported environment only

# --- Not used by the bot --------------------------------------------------
# nemoclaw/scripts/setup.sh falls back to reading this from here when
# onboarding the sandbox against hosted OpenAI. It configures OpenClaw's own
# model; the bot never calls OpenAI.
# OPENAI_API_KEY=
